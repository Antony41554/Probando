<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Interaction="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.EditarProductoView"
             x:DataType="vm:EditarProductoViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Classes="PageHeader">
            <TextBlock Text="Editar Producto"/>
        </Border>

        <!-- Formulario -->
        <Border Grid.Row="1" Margin="16" Classes="ContentPanel">
            <StackPanel Margin="24" Spacing="16">

                <TextBlock Classes="SectionTitle" Text="Datos del Producto"/>

                <!-- Nombre -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="FieldLabel" Text="Nombre"/>
                    <TextBox Text="{Binding Nombre}"
                             Watermark="Nombre del producto">
                        <Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="LostFocus">
                                <ia:InvokeCommandAction Command="{Binding ValidarCampoCommand}"
                                                        CommandParameter="Nombre"/>
                            </ia:EventTriggerBehavior>
                        </Interaction.Behaviors>
                    </TextBox>
                    <TextBlock Classes="ValidationError"
                               Text="{Binding NombreError}"
                               IsVisible="{Binding NombreError,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Precio -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="FieldLabel" Text="Precio"/>
                    <NumericUpDown Value="{Binding Precio}"
                                   Minimum="0"
                                   FormatString="F2"
                                   Increment="0.5">
                        <Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="LostFocus">
                                <ia:InvokeCommandAction Command="{Binding ValidarCampoCommand}"
                                                        CommandParameter="Precio"/>
                            </ia:EventTriggerBehavior>
                        </Interaction.Behaviors>
                    </NumericUpDown>
                    <TextBlock Classes="ValidationError"
                               Text="{Binding PrecioError}"
                               IsVisible="{Binding PrecioError,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Unidades -->
                <StackPanel Spacing="4">
                    <TextBlock Classes="FieldLabel" Text="Unidades en stock"/>
                    <NumericUpDown Value="{Binding Unidades}"
                                   Minimum="0"
                                   Increment="1"
                                   FormatString="F0">
                        <Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="LostFocus">
                                <ia:InvokeCommandAction Command="{Binding ValidarCampoCommand}"
                                                        CommandParameter="Unidades"/>
                            </ia:EventTriggerBehavior>
                        </Interaction.Behaviors>
                    </NumericUpDown>
                    <TextBlock Classes="ValidationError"
                               Text="{Binding UnidadesError}"
                               IsVisible="{Binding UnidadesError,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="16,0,16,16" Classes="FooterPanel">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <Button Grid.Column="1"
                        Classes="BrandButton"
                        Command="{Binding GuardarCommand}"
                        Content="Guardar"/>
                <Button Grid.Column="3"
                        Classes="StandardButton"
                        Command="{Binding VolverCommand}"
                        Content="Cancelar"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3"
                Classes="LoadingOverlay"
                IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="64" Height="64" Margin="0,0,0,16"/>
                <TextBlock Text="Guardando..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>