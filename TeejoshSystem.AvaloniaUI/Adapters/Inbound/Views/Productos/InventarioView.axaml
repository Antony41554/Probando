<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.InventarioView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Classes="PageHeader">
            <TextBlock Text="Inventario"/>
        </Border>

        <!-- Contenido -->
        <Border Grid.Row="1" Margin="16" Classes="ContentPanel">
            <Grid RowDefinitions="Auto,*">

                <!-- Filtros -->
                <StackPanel Grid.Row="0" Margin="24,24,24,16">
                    <TextBlock Classes="SectionTitle"
                               Text="Búsqueda y Filtros"
                               Margin="0,0,0,16"/>
                    <Grid ColumnDefinitions="*,16,200,16,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Busqueda}"
                                 Watermark="Buscar por nombre..."/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding TiposDisponibles}"
                                  SelectedItem="{Binding TipoFiltro}"
                                  DisplayMemberBinding="{Binding Nombre}"
                                  PlaceholderText="Tipo de producto"/>

                        <Button Grid.Column="4"
                                Classes="BrandButton"
                                Command="{Binding CargarCommand}"
                                Content="Buscar"/>
                    </Grid>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Productos}"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="24,0,24,24">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="60"/>
                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="2*"/>
                        <DataGridTextColumn Header="Precio"
                                            Binding="{Binding Precio, StringFormat=\{0:C\}}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding Unidades}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Detalle"
                                            Binding="{Binding DetalleResumen}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="16,0,16,16" Classes="FooterPanel">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Total de productos: "/>
                    <Run Text="{Binding Productos.Count, Mode=OneWay}"
                         FontWeight="Bold"
                         Foreground="{StaticResource BrandBrush}"/>
                </TextBlock>

                <Button Grid.Column="1"
                        Classes="StandardButton"
                        Command="{Binding VolverCommand}"
                        Content="Volver"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3"
                Classes="LoadingOverlay"
                IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="64" Height="64"
                             Margin="0,0,0,16"/>
                <TextBlock Text="Cargando inventario..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>