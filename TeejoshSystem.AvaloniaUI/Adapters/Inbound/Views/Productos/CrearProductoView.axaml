<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validation="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Behaviors"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Productos"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Productos.CrearProductoView"
             x:DataType="vm:CrearProductoViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="PageHeader">
            <TextBlock Text="Crear Producto"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="16">
            <Border Classes="ContentPanel">
                <StackPanel Margin="24" Spacing="16">
                    <Border IsVisible="{Binding HasErrors}"
                            Background="{StaticResource ErrorBackgroundBrush}"
                            CornerRadius="4"
                            Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Corrige los siguientes errores antes de continuar:"
                                       FontWeight="SemiBold"
                                       Classes="ValidationError"/>
                            <ItemsControl ItemsSource="{Binding ResumenErrores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="ValidationError"
                                                   Text="{Binding}"
                                                   Margin="8,2,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="SectionTitle" Text="Datos Generales"/>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="FieldLabel" Text="Tipo de producto"/>
                        <ComboBox ItemsSource="{Binding TiposDisponibles}"
                                  SelectedItem="{Binding TipoSeleccionado}"
                                  DisplayMemberBinding="{Binding Nombre}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="FieldLabel" Text="Nombre"/>
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Watermark="Nombre del producto"
                                 validation:ValidationField.FieldName="Nombre"
                                 validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                 validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                 validation:ValidationField.IsInvalid="{Binding NombreValidation.HasError}"/>
                        <TextBlock Classes="ValidationError"
                                   Text="{Binding NombreValidation.ErrorMessage}"
                                   IsVisible="{Binding NombreValidation.HasError}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="FieldLabel" Text="Precio"/>
                            <TextBox Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Ej: 152.79"
                                     validation:ValidationField.FieldName="PrecioTexto"
                                     validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                     validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                     validation:ValidationField.IsInvalid="{Binding PrecioValidation.HasError}"/>
                            <TextBlock Classes="ValidationError"
                                       Text="{Binding PrecioValidation.ErrorMessage}"
                                       IsVisible="{Binding PrecioValidation.HasError}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="FieldLabel" Text="Unidades"/>
                            <TextBox Text="{Binding UnidadesTexto, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Ej: 10"
                                     validation:ValidationField.FieldName="UnidadesTexto"
                                     validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                     validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                     validation:ValidationField.IsInvalid="{Binding UnidadesValidation.HasError}"/>
                            <TextBlock Classes="ValidationError"
                                       Text="{Binding UnidadesValidation.ErrorMessage}"
                                       IsVisible="{Binding UnidadesValidation.HasError}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="16" IsVisible="{Binding MostrarHotWheels}">
                        <TextBlock Classes="SectionTitle" Text="Detalles Hot Wheels"/>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="FieldLabel" Text="Modelo"/>
                            <TextBox Text="{Binding HwModelo, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Ej: Ford Mustang"
                                     validation:ValidationField.FieldName="HwModelo"
                                     validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                     validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                     validation:ValidationField.IsInvalid="{Binding HwModeloValidation.HasError}"/>
                            <TextBlock Classes="ValidationError"
                                       Text="{Binding HwModeloValidation.ErrorMessage}"
                                       IsVisible="{Binding HwModeloValidation.HasError}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Anio"/>
                                <TextBox Text="{Binding HwAnioTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: 2024"
                                         validation:ValidationField.FieldName="HwAnioTexto"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding HwAnioValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding HwAnioValidation.ErrorMessage}"
                                           IsVisible="{Binding HwAnioValidation.HasError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Serie"/>
                                <TextBox Text="{Binding HwSerie, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: HW Race Team"
                                         validation:ValidationField.FieldName="HwSerie"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding HwSerieValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding HwSerieValidation.ErrorMessage}"
                                           IsVisible="{Binding HwSerieValidation.HasError}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="FieldLabel" Text="Categoria"/>
                            <ComboBox ItemsSource="{Binding CategoriasHotWheels}"
                                      SelectedItem="{Binding HwCategoriaSeleccionada}"
                                      DisplayMemberBinding="{Binding Nombre}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16" IsVisible="{Binding MostrarFunko}">
                        <TextBlock Classes="SectionTitle" Text="Detalles Funko"/>

                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Numero de caja"/>
                                <TextBox Text="{Binding FunkoNumeroBoxTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: 123"
                                         validation:ValidationField.FieldName="FunkoNumeroBoxTexto"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding FunkoNumeroBoxValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding FunkoNumeroBoxValidation.ErrorMessage}"
                                           IsVisible="{Binding FunkoNumeroBoxValidation.HasError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Licencia"/>
                                <TextBox Text="{Binding FunkoLicencia, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: Marvel"
                                         validation:ValidationField.FieldName="FunkoLicencia"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding FunkoLicenciaValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding FunkoLicenciaValidation.ErrorMessage}"
                                           IsVisible="{Binding FunkoLicenciaValidation.HasError}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="FieldLabel" Text="Subtipo"/>
                            <ComboBox ItemsSource="{Binding SubtiposFunko}"
                                      SelectedItem="{Binding FunkoSubtipoSeleccionado}"
                                      DisplayMemberBinding="{Binding Nombre}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="FieldLabel" Text="Caracteristica especial (opcional)"/>
                            <ComboBox ItemsSource="{Binding CaracteristicasFunko}"
                                      SelectedItem="{Binding FunkoCaracteristicaSeleccionada}"
                                      DisplayMemberBinding="{Binding Nombre}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16" IsVisible="{Binding MostrarTcg}">
                        <TextBlock Classes="SectionTitle" Text="Detalles TCG"/>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="FieldLabel" Text="Franquicia"/>
                            <ComboBox ItemsSource="{Binding FranquiciasTcg}"
                                      SelectedItem="{Binding TcgFranquiciaSeleccionada}"
                                      DisplayMemberBinding="{Binding Nombre}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Expansion"/>
                                <ComboBox ItemsSource="{Binding TcgExpansionesDisponibles}"
                                          SelectedItem="{Binding TcgExpansionSeleccionada}"
                                          DisplayMemberBinding="{Binding Nombre}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Pack"/>
                                <ComboBox ItemsSource="{Binding TcgPacksDisponibles}"
                                          SelectedItem="{Binding TcgPackSeleccionado}"
                                          DisplayMemberBinding="{Binding Nombre}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="16" IsVisible="{Binding MostrarToy}">
                        <TextBlock Classes="SectionTitle" Text="Detalles Toy"/>

                        <Grid ColumnDefinitions="*,16,*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Edad minima"/>
                                <TextBox Text="{Binding ToyEdadMinimaTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: 8"
                                         validation:ValidationField.FieldName="ToyEdadMinimaTexto"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding ToyEdadMinimaValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding ToyEdadMinimaValidation.ErrorMessage}"
                                           IsVisible="{Binding ToyEdadMinimaValidation.HasError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Jugadores min."/>
                                <TextBox Text="{Binding ToyJugadoresMinTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: 1"
                                         validation:ValidationField.FieldName="ToyJugadoresMinTexto"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding ToyJugadoresMinValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding ToyJugadoresMinValidation.ErrorMessage}"
                                           IsVisible="{Binding ToyJugadoresMinValidation.HasError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Jugadores max."/>
                                <TextBox Text="{Binding ToyJugadoresMaxTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: 4"
                                         validation:ValidationField.FieldName="ToyJugadoresMaxTexto"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding ToyJugadoresMaxValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding ToyJugadoresMaxValidation.ErrorMessage}"
                                           IsVisible="{Binding ToyJugadoresMaxValidation.HasError}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Es juego de mesa"
                                  IsChecked="{Binding ToyEsJuegoMesa}"/>
                    </StackPanel>

                    <StackPanel Spacing="16" IsVisible="{Binding MostrarVarios}">
                        <TextBlock Classes="SectionTitle" Text="Detalles Varios"/>

                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Marca"/>
                                <TextBox Text="{Binding VariosMarca, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: LEGO"
                                         validation:ValidationField.FieldName="VariosMarca"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding VariosMarcaValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding VariosMarcaValidation.ErrorMessage}"
                                           IsVisible="{Binding VariosMarcaValidation.HasError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Material"/>
                                <TextBox Text="{Binding VariosMaterial, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: Plastico"
                                         validation:ValidationField.FieldName="VariosMaterial"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding VariosMaterialValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding VariosMaterialValidation.ErrorMessage}"
                                           IsVisible="{Binding VariosMaterialValidation.HasError}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,16,*,16,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Alto (cm)"/>
                                <TextBox Text="{Binding VariosAltoTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: 10.5"
                                         validation:ValidationField.FieldName="VariosAltoTexto"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding VariosAltoValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding VariosAltoValidation.ErrorMessage}"
                                           IsVisible="{Binding VariosAltoValidation.HasError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Ancho (cm)"/>
                                <TextBox Text="{Binding VariosAnchoTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Ej: 6.5"
                                         validation:ValidationField.FieldName="VariosAnchoTexto"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding VariosAnchoValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding VariosAnchoValidation.ErrorMessage}"
                                           IsVisible="{Binding VariosAnchoValidation.HasError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="4">
                                <TextBlock Classes="FieldLabel" Text="Largo (cm) - opcional"/>
                                <TextBox Text="{Binding VariosLargoTexto, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="Opcional"
                                         validation:ValidationField.FieldName="VariosLargoTexto"
                                         validation:ValidationField.ValidateCommand="{Binding ValidarCampoCommand}"
                                         validation:ValidationField.ClearCommand="{Binding LimpiarValidacionCampoCommand}"
                                         validation:ValidationField.IsInvalid="{Binding VariosLargoValidation.HasError}"/>
                                <TextBlock Classes="ValidationError"
                                           Text="{Binding VariosLargoValidation.ErrorMessage}"
                                           IsVisible="{Binding VariosLargoValidation.HasError}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Tiene ilustracion"
                                  IsChecked="{Binding VariosTieneIlustracion}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="16,0,16,16" Classes="FooterPanel">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <Button Grid.Column="1"
                        Classes="BrandButton"
                        Command="{Binding GuardarCommand}"
                        Content="Crear Producto"/>
                <Button Grid.Column="3"
                        Classes="StandardButton"
                        Command="{Binding VolverCommand}"
                        Content="Cancelar"/>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                Classes="LoadingOverlay"
                IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="64" Height="64" Margin="0,0,0,16"/>
                <TextBlock Text="Guardando..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
