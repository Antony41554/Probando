<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Menu"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Menu.MenuPrincipalView"
             x:DataType="vm:MenuPrincipalViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Classes="PageHeader">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Menú Principal"
                           VerticalAlignment="Center"/>

                <!-- Selector de tema -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="Tema:"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <ComboBox ItemsSource="{Binding TemasDisponibles}"
                              SelectedItem="{Binding TemaSeleccionado}"
                              DisplayMemberBinding="{Binding Nombre}"
                              Width="130"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <StackPanel Grid.Row="1"
                    Margin="20"
                    Spacing="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button Content="Ver Inventario"
                    Command="{Binding VisualizarInventarioCommand}"
                    Width="220"
                    HorizontalAlignment="Center"
                    Classes="BrandButton"
                    Margin="0,10"/>

            <Button Content="Gestionar Productos"
                    Command="{Binding ModificarProductoCommand}"
                    Width="220"
                    HorizontalAlignment="Center"
                    Classes="StandardButton"/>

            <Button Content="Añadir Producto"
                    Command="{Binding AnadirProductoCommand}"
                    Width="220"
                    HorizontalAlignment="Center"
                    Classes="StandardButton"/>
        </StackPanel>

    </Grid>
</UserControl>