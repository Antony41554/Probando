<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Menu"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Menu.MenuPrincipalView"
             x:DataType="vm:MenuPrincipalViewModel"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="PageHeader">
            <TextBlock Text="Menu Principal"/>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="20"
                    Spacing="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button Content="Ver Inventario"
                    Command="{Binding VisualizarInventarioCommand}"
                    Width="220"
                    HorizontalAlignment="Center"
                    Classes="BrandButton"
                    Margin="0,10"/>

            <Button Content="Gestionar Productos"
                    Command="{Binding ModificarProductoCommand}"
                    Width="220"
                    HorizontalAlignment="Center"
                    Classes="StandardButton"/>

            <Button Content="Anadir Producto"
                    Command="{Binding AnadirProductoCommand}"
                    Width="220"
                    HorizontalAlignment="Center"
                    Classes="StandardButton"/>

            <Button Content="Registrar Venta"
                    Command="{Binding RegistrarVentaCommand}"
                    Width="220"
                    HorizontalAlignment="Center"
                    Classes="SaleButton"/>

            <Button Content="Historial de Ventas"
                    Command="{Binding VerHistorialVentasCommand}"
                    Width="220"
                    HorizontalAlignment="Center"
                    Classes="InfoButton"/>
        </StackPanel>
    </Grid>
</UserControl>
