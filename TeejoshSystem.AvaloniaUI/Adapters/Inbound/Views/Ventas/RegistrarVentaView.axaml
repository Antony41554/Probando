<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.ViewModels.Ventas"
             x:Class="TeejoshSystem.AvaloniaUI.Adapters.Inbound.Views.Ventas.RegistrarVentaView"
             x:DataType="vm:RegistrarVentaViewModel"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="SaleHeader">
            <TextBlock Text="Registrar Venta"/>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="16">
            <Border Grid.Column="0" Classes="ContentPanel">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="12">
                        <TextBlock Text="Productos disponibles"
                                   Classes="SectionTitle"/>
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding TextoBusqueda}"
                                     Watermark="Buscar producto..."/>
                            <Button Grid.Column="2"
                                    Command="{Binding BuscarProductosCommand}"
                                    Content="Buscar"
                                    Classes="SaleButton"
                                    Padding="16,0"/>
                        </Grid>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProductosDisponibles}"
                              SelectedItem="{Binding ProductoSeleccionado}"
                              SelectionMode="Single"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="24,0,24,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*"/>
                            <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=\{0:C\}}" Width="90"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Unidades}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="ContentPanel">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="12">
                        <TextBlock Text="Carrito de venta"
                                   Classes="SectionTitle"/>

                        <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Cantidad:"
                                       VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="2"
                                          Value="{Binding CantidadSeleccionada}"
                                          Minimum="1"
                                          Increment="1"
                                          FormatString="F0"/>
                            <Button Grid.Column="4"
                                    Command="{Binding AgregarItemCommand}"
                                    Content="Agregar"
                                    Classes="SaleButton"
                                    Padding="16,0"/>
                        </Grid>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ItemsVenta}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="24,0,24,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="2*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="50"/>
                            <DataGridTextColumn Header="P.Unit." Binding="{Binding PrecioUnitario, StringFormat=\{0:C\}}" Width="80"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=\{0:C\}}" Width="80"/>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Command="{Binding $parent[UserControl].DataContext.QuitarItemCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                Foreground="{StaticResource DangerBrush}"
                                                Padding="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="24,0,24,24"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="Total:"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TotalVenta, StringFormat=\{0:C\}}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SaleBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="16,0,16,16" Classes="FooterPanel">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
                <Button Grid.Column="1"
                        Command="{Binding ConfirmarVentaCommand}"
                        Content="Confirmar Venta"
                        Classes="SaleButton"/>
                <Button Grid.Column="3"
                        Command="{Binding VolverCommand}"
                        Content="Cancelar"
                        Classes="StandardButton"/>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                Classes="LoadingOverlay"
                IsVisible="{Binding IsBusy}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="64" Height="64" Margin="0,0,0,16"/>
                <TextBlock Text="Procesando venta..."
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
