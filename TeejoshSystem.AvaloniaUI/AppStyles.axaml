<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <Color x:Key="BrandColor">#FF9800</Color>
        <Color x:Key="BrandDarkColor">#E65100</Color>
        <Color x:Key="DangerColor">#E53935</Color>
        <Color x:Key="ErrorColor">#D32F2F</Color>
        <Color x:Key="OverlayColor">#CC000000</Color>

        <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}"/>
        <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>
    </Styles.Resources>

    <!-- VALIDACIÓN -->
    <!-- Al poner Foreground aquí, el TextPresenter interno lo heredará solo -->
    <Style Selector="TextBox:error">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
    </Style>

    <!-- Se eliminó el bloque de TextPresenter que causaba el error -->

    <Style Selector="NumericUpDown:error">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- En NumericUpDown sí funciona porque el template contiene un TextBox real -->
    <Style Selector="NumericUpDown:error /template/ TextBox">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
    </Style>

    <!-- MENSAJE ERROR -->
    <Style Selector="TextBlock.ValidationError">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="2,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- HEADER -->
    <Style Selector="Border.PageHeader">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Padding" Value="24,16"/>
    </Style>

    <Style Selector="Border.PageHeader TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- CONTENT -->
    <Style Selector="Border.ContentPanel">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- FOOTER -->
    <Style Selector="Border.FooterPanel">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- OVERLAY -->
    <Style Selector="Border.LoadingOverlay">
        <Setter Property="Background" Value="{StaticResource OverlayBrush}"/>
    </Style>

    <!-- BOTÓN MARCA -->
    <Style Selector="Button.BrandButton">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <!-- BOTÓN PELIGRO -->
    <Style Selector="Button.DangerButton">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <!-- BOTÓN NORMAL -->
    <Style Selector="Button.StandardButton">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <!-- TÍTULO -->
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- LABEL -->
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

</Styles>