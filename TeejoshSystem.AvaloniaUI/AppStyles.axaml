<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:TeejoshSystem.AvaloniaUI.Adapters.Inbound.Behaviors">

    <Styles.Resources>
        <Color x:Key="BrandColor">#FF9800</Color>
        <Color x:Key="BrandDarkColor">#E65100</Color>
        <Color x:Key="DangerColor">#E53935</Color>
        <Color x:Key="SaleColor">#43A047</Color>
        <Color x:Key="InfoColor">#1565C0</Color>
        <Color x:Key="ErrorColor">#D32F2F</Color>
        <Color x:Key="ErrorBackgroundColor">#1FD32F2F</Color>
        <Color x:Key="OverlayColor">#CC000000</Color>
        <Color x:Key="TitleBarColor">#2C3E50</Color>

        <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}"/>
        <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="SaleBrush" Color="{StaticResource SaleColor}"/>
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackgroundColor}"/>
        <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
    </Styles.Resources>

    <Style Selector="TextBox.validationError">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
    </Style>

    <Style Selector="ComboBox.validationError">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="behaviors:SelectionWheelBlocker.IsEnabled" Value="True"/>
    </Style>

    <Style Selector="TextBlock.ValidationError">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="2,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style Selector="Border.PageHeader">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Padding" Value="24,16"/>
    </Style>

    <Style Selector="Border.SaleHeader">
        <Setter Property="Background" Value="{StaticResource SaleBrush}"/>
        <Setter Property="Padding" Value="24,16"/>
    </Style>

    <Style Selector="Border.InfoHeader">
        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        <Setter Property="Padding" Value="24,16"/>
    </Style>

    <Style Selector="Border.PageHeader TextBlock, Border.SaleHeader TextBlock, Border.InfoHeader TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.ContentPanel">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="Border.FooterPanel">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style Selector="Border.LoadingOverlay">
        <Setter Property="Background" Value="{StaticResource OverlayBrush}"/>
    </Style>

    <Style Selector="Button.BrandButton">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <Style Selector="Button.DangerButton">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <Style Selector="Button.SaleButton">
        <Setter Property="Background" Value="{StaticResource SaleBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <Style Selector="Button.InfoButton">
        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <Style Selector="Button.StandardButton">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
</Styles>
