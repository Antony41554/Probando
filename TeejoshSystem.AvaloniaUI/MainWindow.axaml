<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TeejoshSystem.AvaloniaUI.MainWindow"
        Title="TeejoshSystem - Inventario"
        Width="1024"
        Height="768"
        WindowStartupLocation="CenterScreen"
		x:CompileBindings="False">

	<Grid RowDefinitions="Auto,*">
        
        <!-- Barra de título -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" Height="50">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TeejoshSystem - Gestión de Inventario" 
                           Foreground="White" 
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <!-- Selector de tema -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0"
                            Spacing="8">
                    <TextBlock Classes="FieldLabel"
                            Text="Tema"
                            FontSize="13"
                            VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding $parent[Window].DataContext.TemasDisponibles}"
                            SelectedItem="{Binding $parent[Window].DataContext.TemaSeleccionado}"
                            DisplayMemberBinding="{Binding Nombre}"
                            Width="140"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Contenido dinámico -->
		<ContentControl Grid.Row="1"
						Content="{Binding CurrentView}" />
    </Grid>
</Window>
