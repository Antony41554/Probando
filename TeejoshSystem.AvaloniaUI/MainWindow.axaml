<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TeejoshSystem.AvaloniaUI.MainWindow"
        Title="TeejoshSystem - Inventario"
        Width="1024"
        Height="768"
        WindowStartupLocation="CenterScreen"
		x:CompileBindings="False">

	<Grid RowDefinitions="Auto,*">
        
        <!-- Barra de título -->
        <Border Grid.Row="0" Background="#2C3E50" Height="50">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="TeejoshSystem - Gestión de Inventario" 
                           Foreground="White" 
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <!-- Selector de tema -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Tema:"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <ComboBox ItemsSource="{Binding TemasDisponibles}"
                              SelectedItem="{Binding TemaSeleccionado}"
                              DisplayMemberBinding="{Binding Nombre}"
                              Width="130"
                              VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Contenido dinámico -->
		<ContentControl Grid.Row="1"
						Content="{Binding CurrentView}" />
    </Grid>
</Window>